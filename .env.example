# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API
# ถ้าไม่ใส่ แอปจะทำงานแบบ "บันทึกในเครื่อง" (localStorage) และส่ง LINE ไม่ได้
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ชื่อ LINE OA (Basic ID) แสดงในหน้าโปรไฟล์ให้ลูกหลานเพิ่มเพื่อน เช่น @exospot
VITE_LINE_OA_ID=@exospot
